# Copy to .env and fill with your Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+17343367101

# ── XAU/USD Trader Bot — MetaTrader 5 / Vantage ────────────────────────────
MT5_LOGIN=123456789
MT5_PASSWORD=YourVantagePassword
MT5_SERVER=Vantage-Live
# MT5_PATH=C:\Program Files\Vantage MT5\terminal64.exe   # optional

# ── NewsAPI (https://newsapi.org — free tier is fine) ───────────────────────
NEWS_API_KEY=your_newsapi_key_here
