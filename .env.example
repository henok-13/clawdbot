# Copy to .env and fill with your Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+17343367101

# ── XAU/USD Trader Bot — MetaTrader 5 / Vantage ────────────────────────────
MT5_LOGIN=123456789
MT5_PASSWORD=YourVantagePassword
MT5_SERVER=Vantage-Live
# MT5_PATH=C:\Program Files\Vantage MT5\terminal64.exe   # optional

# ── NewsAPI (https://newsapi.org — free tier is fine) ───────────────────────
NEWS_API_KEY=your_newsapi_key_here

# ── iPhone push notifications via ntfy.sh (free) ────────────────────────────
# 1. Install the "ntfy" app on your iPhone (App Store, free)
# 2. Choose any private topic string — make it hard to guess
# 3. In the ntfy app: tap "+" and subscribe to your topic name
# 4. The bot will push alerts here on every trade event
NTFY_TOPIC=xaubot-yourname-abc123
